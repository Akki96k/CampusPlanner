# Supabase project URL and publishable key are safe to use in browser code.
# Replace these placeholders with values from your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only email delivery. Never prefix these values with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=CampusPlanner <notifications@example.com>
EMAIL_OUTBOX_CRON_SECRET=
# Use your deployed HTTPS origin here in production so reset links open on phones.
# Keep localhost only for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_HELP_URL=
